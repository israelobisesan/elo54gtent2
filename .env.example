# Default Target Facebook Page (can also be changed directly in the web frontend)
FB_TARGET_URL=https://www.facebook.com/RealAmericasVoice

# Video handling behavior:
# False = Ignore video attachments and publish the post's text caption only
# True  = Skip video-only posts and inspect the next post in the feed
SKIP_VIDEO_POSTS=False

# Local Test Publishing Sandbox Settings
TEST_SITE_LOGIN_URL=http://127.0.0.1:5000/login
TEST_SITE_USERNAME=admin
TEST_SITE_PASSWORD=password123

# Flask App Settings
FLASK_SECRET_KEY=dev-sandbox-secret-key
